{
  "name": "sourceflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "prepare": "husky",
    "dev:web": "corepack pnpm --filter @sourceflow/web dev",
    "dev:api": "corepack pnpm --filter @sourceflow/api dev",
    "dev:worker": "corepack pnpm --filter @sourceflow/worker dev",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --max-warnings=0",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.{json,yml,yaml,md}\"",
    "format:write": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.{json,yml,yaml,md}\"",
    "spellcheck": "cspell \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test:unit": "vitest run --config vitest.config.ts --coverage",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:integration": "playwright test --pass-with-no-tests",
    "build:web": "corepack pnpm --filter @sourceflow/web build",
    "build:api": "corepack pnpm --filter @sourceflow/api build",
    "build:worker": "corepack pnpm --filter @sourceflow/worker build",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "cspell": "^9.2.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.11.1",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
