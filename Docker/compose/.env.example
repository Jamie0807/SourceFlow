POSTGRES_IMAGE=postgres:latest
REDIS_IMAGE=redis:latest
POSTGRES_DB=sourceflow
POSTGRES_USER=sourceflow
POSTGRES_PASSWORD=local_sourceflow_change_me
DATABASE_URL=postgresql://sourceflow:local_sourceflow_change_me@localhost:5432/sourceflow?schema=public
REDIS_PASSWORD=local_sourceflow_redis_change_me
REDIS_URL=redis://:local_sourceflow_redis_change_me@localhost:6379
WORKER_CONCURRENCY=2
# AI Provider defaults to the deterministic local mock. Set to volcengine only for explicit manual smoke.
AI_PROVIDER=mock
# LAS API key used only when AI_PROVIDER=volcengine. Keep empty in committed env examples.
LAS_API_KEY=
# Ark API key used only when AI_PROVIDER=volcengine. Keep empty in committed env examples.
ARK_API_KEY=
# LAS asynchronous submit endpoint. Must be credential-free HTTPS.
LAS_ASR_SUBMIT_URL=https://operator.las.cn-beijing.volces.com/api/v1/submit
# LAS asynchronous poll endpoint. Must be credential-free HTTPS.
LAS_ASR_POLL_URL=https://operator.las.cn-beijing.volces.com/api/v1/poll
# LAS model resource. Allowed values: bigasr or seedasr.
LAS_ASR_RESOURCE=bigasr
# Wait time in milliseconds between LAS status polls; allowed range: 100 to 60000.
LAS_ASR_POLL_INTERVAL_MS=2000
# Maximum LAS transcription duration in milliseconds; allowed range: 60000 to 3600000.
LAS_ASR_TIMEOUT_MS=1800000
# Ark OpenAI-compatible API base URL. Must be credential-free HTTPS.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Ark model identifier used for structured text analysis.
ARK_MODEL=doubao-seed-1-6-250615
# Maximum Ark request duration in milliseconds; allowed range: 1000 to 600000.
ARK_TIMEOUT_MS=120000
# Hard gate for the manual real-provider smoke. Leave false for local development, tests, hooks, and CI.
RUN_VOLCENGINE_SMOKE=false
# Required public HTTPS media URL for a separately owned smoke asset; never use localhost MinIO or user media.
VOLCENGINE_SMOKE_MEDIA_URL=
# Optional smoke media format; must match the public test asset. Allowed: mp3, wav, ogg, mp4.
VOLCENGINE_SMOKE_MEDIA_FORMAT=mp4
AUTH_JWT_SECRET=local_sourceflow_jwt_change_me_at_least_32_chars
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
WEB_APP_ORIGIN=http://localhost:5173
WORKSPACE_INVITATION_TTL_SECONDS=604800
POSTGRES_PORT=5432
REDIS_PORT=6379
# Local-only example credentials; replace them for every local environment.
MINIO_ROOT_USER=sourceflow_minio_local
MINIO_ROOT_PASSWORD=local_sourceflow_minio_change_me
# Host-run API/Worker use localhost; a container on this Compose network should use http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000
# Create this bucket once in the MinIO Console before uploading Sources.
MINIO_BUCKET=sourceflow-local
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
