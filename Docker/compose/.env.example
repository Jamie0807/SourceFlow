POSTGRES_IMAGE=postgres:latest
REDIS_IMAGE=redis:latest
POSTGRES_DB=sourceflow
POSTGRES_USER=sourceflow
POSTGRES_PASSWORD=local_sourceflow_change_me
DATABASE_URL=postgresql://sourceflow:local_sourceflow_change_me@localhost:5432/sourceflow?schema=public
REDIS_PASSWORD=local_sourceflow_redis_change_me
REDIS_URL=redis://:local_sourceflow_redis_change_me@localhost:6379
AUTH_JWT_SECRET=local_sourceflow_jwt_change_me_at_least_32_chars
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
WEB_APP_ORIGIN=http://localhost:5173
WORKSPACE_INVITATION_TTL_SECONDS=604800
POSTGRES_PORT=5432
REDIS_PORT=6379
# Local-only example credentials; replace them for every local environment.
MINIO_ROOT_USER=sourceflow_minio_local
MINIO_ROOT_PASSWORD=local_sourceflow_minio_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
